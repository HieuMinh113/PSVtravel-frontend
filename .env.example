# ============================================================
#  PSV Travel — Frontend (Next.js)
#  Copy thành .env.local rồi chỉnh nếu cần
# ============================================================

# Địa chỉ API của backend Laravel.
#
# Dùng 127.0.0.1 chứ KHÔNG dùng localhost. Trên Windows, "localhost" được
# phân giải thành ::1 (IPv6) trước, mà Docker Desktop chuyển tiếp cổng qua
# IPv6 rất chập chờn — Node báo hàng loạt ECONNRESET / UND_ERR_SOCKET kèm
# remoteFamily: 'IPv6'. Ghi thẳng 127.0.0.1 là đi đường IPv4, hết lỗi.
#
# Lên production đổi thành https://api.psvtravel.com/api/v1
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Domain thật của website, dùng cho canonical / Open Graph / sitemap.
# Để trống khi chạy máy nội bộ cũng được.
NEXT_PUBLIC_SITE_URL=https://psvtravel.com
